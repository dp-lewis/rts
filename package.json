{
  "name": "ten-minute-war",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A complete RTS skirmish in about ten minutes, in a browser tab.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:corpus": "vitest run tests/replay",
    "e2e": "playwright test --pass-with-no-tests"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
